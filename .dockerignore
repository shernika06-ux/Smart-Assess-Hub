# ──────────────────────────────────────────────────────
# Smart Assess Hub — Docker Ignore
# ──────────────────────────────────────────────────────

# Build artifacts
target/
*.jar
*.class

# IDE
.idea/
*.iml
.vscode/

# Git
.git/
.gitignore
.gitattributes

# Maven wrapper (rebuilt inside container)
.mvn/wrapper/maven-wrapper.jar

# Docker files (don't copy recursively)
docker-compose.yml
Dockerfile
.dockerignore

# Local data / uploads
uploads-dir/
data/
*.pdf

# OS junk
.DS_Store
Thumbs.db

# Environment secrets
.env
.env.local
.env.production

# Documentation
README.md
HELP.md
*.md

# Node (if any)
node_modules/
frontend/node_modules/
frontend/dist/
